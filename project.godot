; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PPPlayer-(4.7)"
run/main_scene="uid://ck2xb0mwofdp1"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/show_image=false
config/icon="uid://bxdelljv7kbwc"

[audio]

buses/default_bus_layout="uid://4yo58dy0gns"

[autoload]

Global="*res://Singetons/global.gd"
SongManager="*res://Singetons/song_manager.gd"
Tools="*res://Singetons/tools.gd"
DownloadsManager="*res://Singetons/downloads_manager.gd"
HtmlCleaner="*res://Singetons/HTMLCleaner.gd"
YtDlp="*uid://bpqu2omjaonly"
Benchmark="*res://Singetons/benchmark.gd"
WindowsOverlay="*uid://liequk6bvxcn"
Config="*uid://54pmoutdoiwu"
MusicRecommendation="*uid://d3ubf80vbov6l"
Scrapper="*uid://yh3cefmuiggi"
UsePython="*uid://dnro2lp8ux1i"

[display]

window/size/transparent=true
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="PPPlayer"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDContextMenu/plugin.cfg", "res://addons/godot-yt-dlp/plugin.cfg", "res://addons/godot_tree_table/plugin.cfg")

[file_customization]

folder_colors={
"res://BaseScripts/": "red",
"res://Shaders/": "teal",
"res://Singetons/": "pink",
"res://Sprites/": "blue",
"res://Tabs/": "yellow",
"res://Tabs/LibraryTab/": "orange",
"res://Tabs/LibraryTab/DownloadedTab/": "red",
"res://Themes/": "pink",
"res://Windows/": "green"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

debug={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}
